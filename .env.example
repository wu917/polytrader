# PolyTrader 环境变量示例
# 复制为 .env 并填写真实值（.env 已被 gitignore）

# --- Polymarket CLOB API 凭证（live 模式必需；dry-run/paper 可留空）---
# 在 https://polymarket.com/portfolio 创建 API key 后：
# 1. 用私钥签名派生（或使用官方 clob-client 生成的 key）
# 2. 私钥：Polygon 钱包私钥（用于派生 API 凭证与签名）
POLYMARKET_PRIVATE_KEY=
# API key 三元组（创建 API key 时返回）
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# --- 网络代理（中国大陆环境必填，如 127.0.0.1:7890）---
HTTP_PROXY=socks5h://127.0.0.1:7890
HTTPS_PROXY=socks5h://127.0.0.1:7890

# --- LLM 评分（可选，OpenAI 兼容接口）---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
